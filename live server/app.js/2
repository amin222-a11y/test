import { pipeline } from 'https://cdn.jsdelivr.net/npm/@huggingface/transformers@3.5.1/dist/transformers.min.js';

const statusEl = document.querySelector('#status');
const outputEl = document.querySelector('#output');
const btn = document.querySelector('#summarizeBtn');

let summarizer = null;

async function loadModel() {
    statusEl.textContent = 'در حال بارگذاری مدل... (فقط بار اول)';
    summarizer = await pipeline('summarization', 'Xenova/distilbart-cnn-6-6');
    statusEl.textContent = 'مدل آماده‌ست!';
}

btn.addEventListener('click', async () => {
    const text = document.querySelector('#input').value.trim();
    
    if (!text) {
        statusEl.textContent = 'لطفاً یه متن وارد کن!';
        return;
    }
    
    if (!summarizer) {
        statusEl.textContent = 'صبر کن، مدل هنوز لود نشده...';
        return;
    }
    
    btn.disabled = true;
    statusEl.textContent = 'در حال خلاصه‌سازی...';
    
    try {
        const result = await summarizer(text, { max_new_tokens: 60 });
        outputEl.textContent = result[0].summary_text;
        statusEl.textContent = 'تمام شد!';
    } catch (err) {
        statusEl.textContent = 'خطا: ' + err.message;
    } finally {
        btn.disabled = false;
    }
});

// مدل رو همون اول لود می‌کنیم تا کاربر هر بار منتظر نمونه
loadModel();